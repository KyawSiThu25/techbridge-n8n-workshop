      "parameters": {
        "promptType": "define",
        "text": "={{ $json.message.text }}",
        "options": {
          "systemMessage": "You are the TechBridge Club Telegram assistant for Hawhaw, a Club Officer. You can chat normally and answer questions, and you have four tools: \"Book Calendar Event\" (create a Google Calendar booking), \"Read Calendar Events\" (look up upcoming events), and \"Read Gmail Messages\" (search recent Gmail). Only use a tool when the user asks for something that requires it (booking, checking the calendar, or checking email). When booking events, always confirm the date, time, and title back to the user in your reply. Keep replies concise and use plain text suitable for a Telegram chat message (no heavy markdown)."
        }
      },
      "id": "f6cea122-edbc-47ff-8355-fe9186c5439d",
      "name": "TechBridge Assistant Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        416,
        112
      ]
    },
    {
      "parameters": {
        "sessionIdType": "customKey",
        "sessionKey": "={{ $('Telegram Trigger').item.json.message.chat.id }}",
